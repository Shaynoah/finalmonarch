# Vite (copy to .env or .env.local; never commit real secrets)
# Public site key for Cloudflare Turnstile — pair with TURNSTILE_SECRET_KEY in server/.env
# https://developers.cloudflare.com/turnstile/
VITE_TURNSTILE_SITE_KEY=

# Optional: full URL to email API in production (defaults to /api/... on same origin)
# VITE_CONTACT_API_URL=https://api.yourdomain.com/api/contact
# VITE_CLAIM_API_URL=https://api.yourdomain.com/api/claim
