# Office 365 SMTP (mailbox must allow SMTP AUTH if required by tenant policy)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587

SENDER_EMAIL=alerts@monarchinsurance.co.ke
# Set only in .env (never commit .env). If the value contains # use double quotes:
# SENDER_PASSWORD="your#password"
SENDER_PASSWORD=

# Contact / quote form (POST /api/contact). Optional legacy key CONTACT_RECIPIENT_EMAIL.
# snoah@monarchinsurance.co.ke is always appended to To for contact, quote, and claim mail (not configurable here).
FORM_RECIPIENT_EMAIL=info@monarchinsurance.co.ke

# Get a Quote page only (formSource get-a-quote). Comma or semicolon separated. If unset, defaults to:
# requests@monarchinsurance.co.ke, gmunywoki@monarchinsurance.co.ke
# QUOTE_RECIPIENT_EMAIL=requests@monarchinsurance.co.ke, gmunywoki@monarchinsurance.co.ke

# Claim form (POST /api/claim). Comma or semicolon separated. If unset, defaults to:
# claimsteam@monarchinsurance.co.ke, gmunywoki@monarchinsurance.co.ke
# CLAIM_RECIPIENT_EMAIL=claimsteam@monarchinsurance.co.ke, gmunywoki@monarchinsurance.co.ke

# --- Anti-abuse (optional) ---
# Per-IP limit for POST /api/contact and POST /api/claim (Flask-Limiter). Set to "false" to disable.
RATE_LIMIT_ENABLED=true
# Examples: "10 per minute", "30 per hour", "5 per 1 minutes"
RATE_LIMIT_FORMS=10 per minute
# For multiple app workers, use redis: RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Cloudflare Turnstile (optional). If set, the frontend must send the token (VITE_TURNSTILE_SITE_KEY in the Vite .env).
# Get keys: https://dash.cloudflare.com/ → Turnstile
TURNSTILE_SECRET_KEY=

FLASK_PORT=5000
