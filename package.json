{
  "name": "monarch-insurance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "build": "npm run generate:sitemap && vite build && react-snap",
    "build:netlify": "npm run generate:sitemap && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "react-snap": "^1.23.0",
    "vite": "^5.0.8"
  },
  "reactSnap": {
    "source": "dist",
    "crawl": false,
    "skipThirdPartyRequests": true,
    "include": [
      "/",
      "/contact",
      "/group-life-insurance",
      "/group-retirement-benefit-schemes",
      "/group-credit-life",
      "/group-life",
      "/group-personal-accident",
      "/customs",
      "/immigration-security",
      "/performance",
      "/surety-undertaking",
      "/tender",
      "/comesa-yellow-card",
      "/domestic-package",
      "/contractors-all-risks",
      "/contractors-plant-machinery",
      "/electronic-equipment",
      "/machinery-breakdown",
      "/golfers-insurance",
      "/consequential-loss",
      "/motor-vehicle",
      "/fire-and-perils",
      "/industrial",
      "/carriers",
      "/professional-indemnity",
      "/public-liability",
      "/work-injury",
      "/goods-in-transit",
      "/marine-hull",
      "/marine-cargo",
      "/institutional-fleet",
      "/chauffeur-driven-psv",
      "/general-cartage",
      "/motor-cycle",
      "/burglary",
      "/get-a-quote",
      "/forms",
      "/report-claim",
      "/service-providers"
